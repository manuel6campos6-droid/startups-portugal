# Chave da conta Apify DESTE projecto (não a da NOITE): https://console.apify.com/settings/integrations
APIFY_TOKEN=apify_api_...
# Máximo que cada corrida do LinkedIn pode gastar, em USD. O plano grátis dá 5 USD por mês.
APIFY_TETO_USD=2

# Bot do Telegram que avisa das vagas novas (criado no @BotFather; não é o da NOITE)
TELEGRAM_VAGAS_TOKEN=
# O chat do Manuel com esse bot; o npm run avisar mostra-o depois do /start
TELEGRAM_VAGAS_CHAT_ID=
